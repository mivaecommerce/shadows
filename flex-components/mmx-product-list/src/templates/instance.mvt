<mvt:assign name="l.settings:instance:fallback_product_image" value="'graphics/' $ padl( g.Store:id, 8, '0' ) $ '/catalog-fallback-image__335x335.jpg'" />
<mvt:assign name="l.settings:instance:heading:heading_text:value" value="glosub( l.settings:instance:heading:heading_text:value, '%search%', g.Search )" />

<mvt:comment>Pass Server Data</mvt:comment>
<mvt:assign name="l.settings:instance:server:search" value="g.Search" />

<mvt:comment>Determine Automatic Category</mvt:comment>
<mvt:if expr="
	l.settings:instance:list:products:product_set:value EQ 'auto' OR
	(
		l.settings:instance:list:products:product_set:value EQ 'category' AND
		l.settings:instance:list:products:category_source:value EQ 'auto'
	)
">
	<mvt:assign name="l.settings:instance:list:products:category:category_code" value="l.settings:category:code" />
	<mvt:assign name="l.settings:instance:list:products:category:category" value="l.settings:category" />
</mvt:if>

<mvt:comment>Determine Automatic Product</mvt:comment>
<mvt:if expr="
	l.settings:instance:list:products:product_set:value EQ 'auto' OR
	(
		l.settings:instance:list:products:product_set:value EQ 'related' AND
		l.settings:instance:list:products:related_source:value EQ 'auto'
	)
">
	<mvt:assign name="l.settings:instance:list:products:product:product_code" value="l.settings:product:code" />
	<mvt:assign name="l.settings:instance:list:products:product:product" value="l.settings:product" />
</mvt:if>

<mvt:comment>Determine Showcase Context</mvt:comment>
<mvt:if expr="l.settings:instance:list:products:product_set:value EQ 'merchandising'">
	<mvt:if expr="l.settings:instance:list:products:showcase:context:product_id">
		<mvt:assign name="l.settings:instance:list:products:showcase:context:product" value="l.settings:product" />
	</mvt:if>

	<mvt:if expr="l.settings:instance:list:products:showcase:context:category_id">
		<mvt:assign name="l.settings:instance:list:products:showcase:context:category" value="l.settings:category" />
	</mvt:if>
</mvt:if>

<mvt:comment>Determine Content Params</mvt:comment>
<mvt:assign name="l.settings:content_params" value="''" />
<mvt:if expr="l.settings:instance:list:products:product_set:value EQ 'merchandising'">
	<mvt:assign name="l.settings:content_params:showcase" value="l.settings:instance:list:products:showcase:code" />
<mvt:elseif expr="
	l.settings:instance:list:products:product_set:value EQ 'category' OR
	(
		l.settings:instance:list:products:product_set:value EQ 'auto' AND
		ISNULL l.settings:instance:list:products:product:product_code AND
		NOT ISNULL l.settings:instance:list:products:category:category_code
	)
">
	<mvt:assign name="l.settings:content_params:category" value="l.settings:instance:list:products:category:category_code" />
<mvt:else>
	<mvt:assign name="l.settings:content_params:search_term" value="g.Search" />
</mvt:if>

<mvt:comment>Determine component id & page-code</mvt:comment>
<mvt:if expr="NOT ISNULL l.settings:fragment:code">
	<mvt:assign name="l.settings:page_code"		value="l.settings:fragment:code" />
	<mvt:assign name="l.settings:component_id"	value="l.settings:page_code $ '__' $ l.settings:instance_item:component_code $ '__' $ l.settings:instance_item:item_code" />
<mvt:else>
	<mvt:assign name="l.settings:page_code"		value="l.settings:page:code" />
	<mvt:assign name="l.settings:component_id"	value="l.settings:instance_item:component_code $ '__' $ l.settings:instance_item:item_code" />
</mvt:if>

<mvt:comment>Determine if customer is logged in or not</mvt:comment>
<mvt:if expr="l.settings:instance:card:add_to_wishlist:settings:enabled">
	<mvt:assign name="l.settings:instance:card:add_to_wishlist:needs_login" value="g.Basket:cust_id EQ 0" />
</mvt:if>

<mvt:comment>Initial Display</mvt:comment>
<mvt:if expr="l.settings:instance:advanced:initial_display:initial_height:value EQ 'auto'">
	<mvt:assign name="l.settings:instance:advanced:initial_display:initial_height_amount:formatted_value" value="'100vh'" />
<mvt:elseif expr="l.settings:instance:advanced:initial_display:initial_height:value EQ 'none'">
	<mvt:assign name="l.settings:instance:advanced:initial_display:initial_height_amount:value" value="''" />
	<mvt:assign name="l.settings:instance:advanced:initial_display:initial_height_amount:unit" value="''" />
</mvt:if>

<mvt:if expr="NOT ISNULL l.settings:instance:advanced:initial_display:initial_height_amount:value AND NOT ISNULL l.settings:instance:advanced:initial_display:initial_height_amount:unit">
	<mvt:assign name="l.settings:instance:advanced:initial_display:initial_height_amount:formatted_value" value="l.settings:instance:advanced:initial_display:initial_height_amount:value $ l.settings:instance:advanced:initial_display:initial_height_amount:unit" />
</mvt:if>

<mvt:comment>Structured Data</mvt:comment>
<mvt:assign name="l.structured_data_json" value="''" />
<mvt:if expr="l.settings:instance:advanced:structured_data:mode:value EQ 'fragment' AND NOT ISNULL l.settings:instance:advanced:structured_data:fragment:value">
	<mvt:assign name="l.settings:structured_data:context" value="'product_list'" />

	<mvt:if expr="l.settings:instance:heading:settings:enabled AND NOT ISNULL l.settings:instance:heading:heading_text:value">
		<mvt:assign name="l.settings:structured_data:list_name" value="miva_html_strip( l.settings:instance:heading:heading_text:value, '' )" />
	<mvt:elseif expr="l.settings:instance:list:products:product_set:value EQ 'category' OR
					  ( l.settings:instance:list:products:product_set:value EQ 'auto' AND ISNULL l.settings:instance:list:products:product:product_code )">
		<mvt:assign name="l.settings:structured_data:list_name" value="l.settings:instance:list:products:category:category:name" />
	</mvt:if>

	<mvt:capture variable="l.structured_data_json"><mvt:do file="g.Module_Feature_TUI_MGR" name="l.null" value="TemplateManager_Fragment_Render( l.settings, l.settings:instance:advanced:structured_data:fragment:value, l.null )" /></mvt:capture>
	<mvt:assign name="l.null" value="miva_member_delete( l.settings, 'structured_data' )" />
</mvt:if>

<mvt:comment>Render Component</mvt:comment>
<mmx-product-list
	id="&mvte:component_id;"
	data-page-code="&mvte:page_code;"
	data-flex-component="&mvte:instance_item:component_code;"
	data-flex-item="&mvte:instance_item:item_code;"
	data-category="&mvte:content_params:category;"
	data-showcase="&mvte:content_params:showcase;"
	data-search-term="&mvte:content_params:search_term;"
	data-init="script"
	style="
		margin-top: &mvte:instance:advanced:spacing:top:value;px;
		margin-bottom: &mvte:instance:advanced:spacing:bottom:value;px;
		--mmx-initial-height: &mvte:instance:advanced:initial_display:initial_height_amount:formatted_value;;
	"
	data-adpr-url="&mvte:urls:BASK:auto;"
	data-atwl-url="&mvte:urls:WISH:auto;"
	class="mmx-wrapper"
>
	<mvt:comment>Init Script</mvt:comment>
	<script type="application/json">
		<mvt:eval expr="miva_json_encode( l.settings:instance, '' )" />
	</script>

	<mvt:comment>Structured Data</mvt:comment>
	<mvt:if expr="NOT ISNULL l.structured_data_json">
		<script type="application/ld+json" class="mmx-skip-mutation">
			<mvt:eval expr="l.structured_data_json" />
		</script>
	</mvt:if>

	<mvt:comment>Render Section Heading</mvt:comment>
	<mvt:if expr="l.settings:instance:heading:settings:enabled AND NOT ISNULL l.settings:instance:heading:heading_text:value">
		<mvt:if expr="ISNULL l.settings:instance:heading:heading_text:textsettings:fields:normal:heading_style:value OR l.settings:instance:heading:heading_text:textsettings:fields:normal:heading_style:value EQ 'default'">
			<mvt:assign name="l.settings:instance:heading:heading_text:textsettings:fields:normal:heading_style:value" value="'title-1'" />
		</mvt:if>
		<mmx-text
			slot="title"
			data-theme="&mvte:instance:heading:heading_text:textsettings:fields:normal:typography_theme:theme_available;"
			data-theme-class="&mvte:instance:heading:heading_text:textsettings:fields:normal:typography_theme:classname;"
			data-style="&mvte:instance:heading:heading_text:textsettings:fields:normal:heading_style:value;"
			data-tag="&mvte:instance:heading:heading_text:textsettings:fields:normal:heading_tag:value;"
			data-align="&mvte:instance:heading:heading_align:value;"
		>
			<mvt:if expr="l.settings:instance:heading:heading_text:textsettings:fields:normal:typography_theme:theme_available">
				<mvt:if expr="NOT ISNULL l.settings:instance:heading:heading_text:textsettings:fields:normal:typography_theme:stylesheet">
					<template data-theme-stylesheet>
						&mvt:instance:heading:heading_text:textsettings:fields:normal:typography_theme:stylesheet;
					</template>
				</mvt:if>
			<mvt:elseif expr="NOT ISNULL l.settings:instance:heading:heading_text:textsettings:styles:normal">
				<template data-legacy-styles>
					&mvt:instance:heading:heading_text:textsettings:styles:normal;
				</template>
			</mvt:if>

			&mvte:instance:heading:heading_text:value;
		</mmx-text>
	</mvt:if>

	<mvt:comment>Render Category Tree</mvt:comment>
	<mvt:if expr="l.settings:instance:list:facets:show_category_tree:value">
		<div slot="category-tree">
			<mvt:item name="category_tree" />
		</div>
	</mvt:if>

	<mvt:capture variable="l.theme_stylesheet"><mvt:miva output="off" />
		<mvt:comment> Theme Badges </mvt:comment>
		<mvt:if expr="NOT ISNULL l.settings:instance:advanced:message_badges:error_badge:stylesheet">
			<mvt:eval expr="l.settings:instance:advanced:message_badges:error_badge:stylesheet" />
		</mvt:if>
		<mvt:if expr="NOT ISNULL l.settings:instance:advanced:empty_results_message:textsettings:fields:normal:badge_theme:stylesheet">
			<mvt:eval expr="l.settings:instance:advanced:empty_results_message:textsettings:fields:normal:badge_theme:stylesheet" />
		</mvt:if>

		<mvt:if expr="NOT ISNULL l.settings:instance:list:facets:title:textsettings:fields:normal:typography_theme:stylesheet">
			<mvt:eval expr="l.settings:instance:list:facets:title:textsettings:fields:normal:typography_theme:stylesheet" />
		</mvt:if>
		<mvt:if expr="NOT ISNULL l.settings:instance:list:facets:facet_styles:typography_theme:stylesheet">
			<mvt:eval expr="l.settings:instance:list:facets:facet_styles:typography_theme:stylesheet" />
		</mvt:if>

		<mvt:foreach iterator="detail" array="instance:card:details:children">
			<mvt:if expr="l.settings:detail:type:value EQ 'button__view-product'	OR
						  l.settings:detail:type:value EQ 'button__add-to-cart'		OR
						  l.settings:detail:type:value EQ 'button__add-to-wishlist'">
				<mvt:if expr="NOT ISNULL l.settings:detail:button:text:textsettings:fields:normal:button_theme:stylesheet">
					<mvt:eval expr="l.settings:detail:button:text:textsettings:fields:normal:button_theme:stylesheet" />
				</mvt:if>
			<mvt:elseif expr="l.settings:detail:type:value EQ 'price'">
				<mvt:if expr="NOT ISNULL l.settings:detail:price_text_styles:displayed:typography_theme:stylesheet">
					<mvt:eval expr="l.settings:detail:price_text_styles:displayed:typography_theme:stylesheet" />
				</mvt:if>
				<mvt:if expr="NOT ISNULL l.settings:detail:price_text_styles:additional:typography_theme:stylesheet">
					<mvt:eval expr="l.settings:detail:price_text_styles:additional:typography_theme:stylesheet" />
				</mvt:if>
			<mvt:elseif expr="l.settings:detail:type:value EQ 'name'			OR
							  l.settings:detail:type:value EQ 'code'			OR
							  l.settings:detail:type:value EQ 'sku'				OR
							  l.settings:detail:type:value EQ 'descrip'			OR
							  l.settings:detail:type:value EQ 'weight'			OR
							  l.settings:detail:type:value EQ 'customfield'		OR
							  l.settings:detail:type:value EQ 'fragment'		OR
							  l.settings:detail:type:value EQ 'inv_short'		OR
							  l.settings:detail:type:value EQ 'inv_long'		OR
							  l.settings:detail:type:value EQ 'inv_available'	OR
							  l.settings:detail:type:value EQ 'quantity'		OR
							  l.settings:detail:type:value EQ 'discounts'">
				<mvt:if expr="NOT ISNULL l.settings:detail:text_styles:typography_theme:stylesheet">
					<mvt:eval expr="l.settings:detail:text_styles:typography_theme:stylesheet" />
				</mvt:if>
			</mvt:if>
		</mvt:foreach>

		<mvt:if expr="l.settings:instance:card:flags:settings:enabled">
			<mvt:foreach iterator="flag" array="instance:card:flags:list:children">
				<mvt:if expr="l.settings:flag:type:value EQ 'inv_short'">
					<mvt:if expr="NOT ISNULL l.settings:flag:badge_in:stylesheet">
						<mvt:eval expr="l.settings:flag:badge_in:stylesheet" />
					</mvt:if>
					<mvt:if expr="NOT ISNULL l.settings:flag:badge_low:stylesheet">
						<mvt:eval expr="l.settings:flag:badge_low:stylesheet" />
					</mvt:if>
					<mvt:if expr="NOT ISNULL l.settings:flag:badge_out:stylesheet">
						<mvt:eval expr="l.settings:flag:badge_out:stylesheet" />
					</mvt:if>
				<mvt:elseif expr="NOT ISNULL l.settings:flag:badge:stylesheet">
					<mvt:eval expr="l.settings:flag:badge:stylesheet" />
				</mvt:if>
			</mvt:foreach>
		</mvt:if>
	<mvt:miva output="on" compresswhitespace="on" /></mvt:capture>

	<mvt:if expr="NOT ISNULL l.theme_stylesheet">
		<template data-theme-stylesheet>
			<mvt:eval expr="l.theme_stylesheet" />
		</template>
	</mvt:if>
</mmx-product-list>