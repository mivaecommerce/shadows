									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:add_to_wishlist_button:textsettings:fields:normal:button_theme:stylesheet">
										<mvt:eval expr="l.settings:level_5_detail:add_to_wishlist_button:textsettings:fields:normal:button_theme:stylesheet" />
									</mvt:if>
								<mvt:elseif expr="l.settings:level_5_detail:type:value EQ 'vertical-group' AND l.settings:level_5_detail:max_height_settings:settings:enabled">
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:max_height_settings:read_more:textsettings:fields:normal:button_theme:stylesheet">
										<mvt:eval expr="l.settings:level_5_detail:max_height_settings:read_more:textsettings:fields:normal:button_theme:stylesheet" />
									</mvt:if>
								<mvt:elseif expr="l.settings:level_5_detail:type:value EQ 'tab-group'">
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:accordion_settings:heading:typography_theme:stylesheet">
										<mvt:eval expr="l.settings:level_5_detail:accordion_settings:heading:typography_theme:stylesheet" />
									</mvt:if>
								<mvt:elseif expr="l.settings:level_5_detail:type:value EQ 'accordion-group'">
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:tab_settings:typography_theme:stylesheet">
										<mvt:eval expr="l.settings:level_5_detail:tab_settings:typography_theme:stylesheet" />
									</mvt:if>
								<mvt:elseif expr="l.settings:level_5_detail:type:value EQ 'volume-pricing-table'">
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:volume_pricing_table_settings:quantity:textsettings:fields:normal:typography_theme:stylesheet">	<mvt:eval expr="l.settings:level_5_detail:volume_pricing_table_settings:quantity:textsettings:fields:normal:typography_theme:stylesheet" />	</mvt:if>
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:volume_pricing_table_settings:price:textsettings:fields:normal:typography_theme:stylesheet">		<mvt:eval expr="l.settings:level_5_detail:volume_pricing_table_settings:price:textsettings:fields:normal:typography_theme:stylesheet" />	</mvt:if>
								<mvt:elseif expr="l.settings:level_5_detail:type:value EQ 'inv_long' OR l.settings:level_5_detail:type:value EQ 'inv_short'">
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:message_styles:badge_theme_in:stylesheet">		<mvt:eval expr="l.settings:level_5_detail:message_styles:badge_theme_in:stylesheet" />		</mvt:if>
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:message_styles:badge_theme_low:stylesheet">	<mvt:eval expr="l.settings:level_5_detail:message_styles:badge_theme_low:stylesheet" />	</mvt:if>
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:message_styles:badge_theme_out:stylesheet">	<mvt:eval expr="l.settings:level_5_detail:message_styles:badge_theme_out:stylesheet" />	</mvt:if>
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:message_styles:badge_theme_invalid:stylesheet">	<mvt:eval expr="l.settings:level_5_detail:message_styles:badge_theme_invalid:stylesheet" />	</mvt:if>
								<mvt:elseif expr="l.settings:level_5_detail:type:value EQ 'fitment'">
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:fitment_settings:messages:universal_message:textsettings:fields:normal:badge_theme:stylesheet">	<mvt:eval expr="l.settings:level_5_detail:fitment_settings:messages:universal_message:textsettings:fields:normal:badge_theme:stylesheet" />	</mvt:if>
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:fitment_settings:messages:exact_message:textsettings:fields:normal:badge_theme:stylesheet">	<mvt:eval expr="l.settings:level_5_detail:fitment_settings:messages:exact_message:textsettings:fields:normal:badge_theme:stylesheet" />	</mvt:if>
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:fitment_settings:messages:partial_message:textsettings:fields:normal:badge_theme:stylesheet">	<mvt:eval expr="l.settings:level_5_detail:fitment_settings:messages:partial_message:textsettings:fields:normal:badge_theme:stylesheet" />	</mvt:if>
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:fitment_settings:messages:none_message:textsettings:fields:normal:badge_theme:stylesheet">	<mvt:eval expr="l.settings:level_5_detail:fitment_settings:messages:none_message:textsettings:fields:normal:badge_theme:stylesheet" />	</mvt:if>
								<mvt:elseif expr="l.settings:level_5_detail:type:value EQ 'fitment-list'">
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:fitment_list_settings:message_badges:error_badge:stylesheet">	<mvt:eval expr="l.settings:level_5_detail:fitment_list_settings:message_badges:error_badge:stylesheet" />	</mvt:if>
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:fitment_list_settings:message_badges:empty_badge:stylesheet">	<mvt:eval expr="l.settings:level_5_detail:fitment_list_settings:message_badges:empty_badge:stylesheet" />	</mvt:if>
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:fitment_list_table_styles:header_typography:stylesheet">		<mvt:eval expr="l.settings:level_5_detail:fitment_list_table_styles:header_typography:stylesheet" />	</mvt:if>
									<mvt:if expr="NOT ISNULL l.settings:level_5_detail:fitment_list_table_styles:content_typography:stylesheet">	<mvt:eval expr="l.settings:level_5_detail:fitment_list_table_styles:content_typography:stylesheet" />	</mvt:if>
								<mvt:elseif expr="l.settings:level_5_detail:type:value EQ 'code'				OR
												  l.settings:level_5_detail:type:value EQ 'customfield'			OR
												  l.settings:level_5_detail:type:value EQ 'custom-text'			OR
												  l.settings:level_5_detail:type:value EQ 'descrip'				OR
												  l.settings:level_5_detail:type:value EQ 'discounts'			OR
												  l.settings:level_5_detail:type:value EQ 'fragment'			OR
												  l.settings:level_5_detail:type:value EQ 'inv_available'		OR
												  l.settings:level_5_detail:type:value EQ 'name'				OR
												  l.settings:level_5_detail:type:value EQ 'price'				OR
												  l.settings:level_5_detail:type:value EQ 'quantity-in-basket'	OR
												  l.settings:level_5_detail:type:value EQ 'sku'					OR
												  l.settings:level_5_detail:type:value EQ 'weight'">
									<mvt:if expr="l.settings:level_5_detail:text_styles:settings:enabled">
										<mvt:if expr="NOT ISNULL l.settings:level_5_detail:text_styles:typography_theme:stylesheet">
											<mvt:eval expr="l.settings:level_5_detail:text_styles:typography_theme:stylesheet" />
										</mvt:if>
									</mvt:if>
								</mvt:if>
							</mvt:foreach>
						</mvt:foreach>
					</mvt:foreach>
				</mvt:foreach>
			</mvt:foreach>
		<mvt:miva output="on" compresswhitespace="on" /></mvt:capture>

		<mvt:if expr="NOT ISNULL l.theme_stylesheet">
			<template data-theme-stylesheet>
				<mvt:eval expr="l.theme_stylesheet" />
			</template>
		</mvt:if>
	</mmx-product-details>
</form>