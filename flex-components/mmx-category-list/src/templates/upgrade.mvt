<mvt:if expr="l.settings:instance:_flex:settings_version LT '26.01.02'">
	<mvt:assign name="l.settings:instance:advanced:initial_display:initial_height:value" value="'auto'" />
</mvt:if>

<mvt:if expr="l.settings:instance:_flex:settings_version LT '26.03.00'">
	<mvt:assign name="l.settings:instance:advanced:structured_data:mode:value" value="ternary( l.settings:instance:advanced:emit_json_ld:value, 'auto', 'none' )" />
	<mvt:assign name="l.settings:instance:advanced:structured_data:fragment:value" value="'json_ld'" />
	<mvt:eval expr="miva_member_delete( l.settings:instance:advanced, 'emit_json_ld' )" />

	<mvt:comment> Badges: Disable Theme Mode on Upgrade </mvt:comment>
	<mvt:assign name="l.settings:instance:advanced:message_badges:error_badge:theme_mode" value="0" />
</mvt:if>